{
  "name": "@octanttech/plugin-runtime-sdk",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --outfile dist/index.js --external semver --external sm-crypto --external zod && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "keys": "bun scripts/generate-keys.ts"
  },
  "dependencies": {
    "semver": "^7.7.2",
    "sm-crypto": "^0.3.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^24.0.0"
  },
  "description": "InteMatrix plugin runtime SDK: manifest 校验、crypto/sm4 密文协议、依赖声明与工具定义（平台插件开发用）",
  "repository": {
    "type": "git",
    "url": "https://github.com/OctantTech/IM-plugin-SDK.git"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
